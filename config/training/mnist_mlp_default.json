{
  "scheduler_type": "step_decay",
  "step_size": 3,
  "gamma": 0.5,

  "warmup": {
    "type": "linear",
    "epochs": 2,
    "start_lr": 0.001
  },

  "regularization": {
    "l1": 0.0,
    "l2": 0.00001
  },

  "gradient_clipping": {
    "type": "norm",
    "max_norm": 1.0
  },

  "activation_function": "relu",
  "learning_rate": 0.01,
  "epochs": 10,
  "batch_size": 64,
  "validation_split": 0.1,
  "early_stopping_patience": 3,
  "early_stopping_min_delta": 0.001,
  "enable_augmentation": false
}
